{% doc %}
  One buy-together kit: product rows, a running total and an add-everything button.

  @param {string} uid - Unique id for form fields.
  @param {string} title - Kit name.
  @param {string} [text] - One line about the kit.
  @param {object} products - Up to six products.
  @param {string} [button_label] - Button text.
  @param {string} [attributes] - Extra HTML attributes for the wrapper.
{% enddoc %}

<mr-kit class="mr-kit" data-currency="{{ cart.currency.iso_code }}" {{ attributes }}>
    <h3 class="mr-kit__title h3">{{ title | escape }}</h3>
    {%- if text != blank -%}
      <p class="mr-kit__text">{{ text | escape }}</p>
    {%- endif -%}
    <ul class="mr-kit__items" role="list">
      {%- for product in products limit: 6 -%}
        {%- assign options = product.variants | where: 'available', true | sort: 'price' -%}
        {%- if options.size > 0 -%}
          <li class="mr-kit__item">
            <a class="mr-kit__thumb" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
              {%- if product.featured_image -%}
                {{ product.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', widths: '60, 120', sizes: '60px', alt: '' }}
              {%- endif -%}
            </a>
            <div class="mr-kit__info">
              <a class="mr-kit__name" href="{{ product.url }}">{{ product.title | escape }}</a>
              {%- if options.size > 1 -%}
                <label class="visually-hidden" for="Kit-{{ uid }}-{{ product.id }}">{{ product.title | escape }}</label>
                <select class="mr-kit__select" id="Kit-{{ uid }}-{{ product.id }}">
                  {%- for variant in options -%}
                    <option value="{{ variant.id }}" data-price="{{ variant.price }}">{{ variant.title | escape }} ({{ variant.price | money }})</option>
                  {%- endfor -%}
                </select>
              {%- else -%}
                <input type="hidden" class="mr-kit__fixed" value="{{ options.first.id }}" data-price="{{ options.first.price }}">
                <span class="mr-kit__price">{{ options.first.price | money }}</span>
              {%- endif -%}
            </div>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
    <div class="mr-kit__foot">
      <span class="mr-kit__total-label">Kit total</span>
      <strong class="mr-kit__total">&nbsp;</strong>
      <button type="button" class="button mr-kit__add">{{ button_label | default: 'Add kit to basket' | escape }}</button>
    </div>
    <p class="mr-kit__status visually-hidden" role="status"></p>
  </mr-kit>

<script src="{{ 'mr-kit.js' | asset_url }}" defer="defer"></script>

{% stylesheet %}
  .mr-kit {
    display: flex;
    flex-direction: column;
    padding: 2rem;
    border: 1px dashed var(--mr-sky);
    border-radius: 0.8rem;
    background: #fff;
  }
  .mr-kit__title {
    margin: 0 0 0.4rem;
  }
  .mr-kit__text {
    margin: 0 0 1.2rem;
    color: var(--mr-muted);
  }
  .mr-kit__items {
    display: grid;
    gap: 1rem;
    margin: 0 0 1.6rem;
    padding: 0;
    list-style: none;
  }
  .mr-kit__item {
    display: grid;
    grid-template-columns: 6rem 1fr;
    align-items: center;
    gap: 1.2rem;
  }
  .mr-kit__thumb img {
    display: block;
    width: 6rem;
    height: 6rem;
    object-fit: cover;
    border: 1px solid var(--mr-tan);
  }
  .mr-kit__info {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 0;
  }
  .mr-kit__name {
    color: var(--mr-navy);
    font-weight: 700;
    text-decoration: none;
  }
  .mr-kit__select {
    width: 100%;
    min-height: 4rem;
    padding: 0 0.8rem;
    border: 1px solid var(--mr-tan);
    border-radius: 0.4rem;
    background: #fff;
    color: var(--mr-navy);
    font: inherit;
  }
  .mr-kit__price {
    color: var(--mr-muted);
  }
  .mr-kit__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem 1.2rem;
    margin-top: auto;
    padding-top: 1.2rem;
    border-top: 1px solid var(--mr-tan);
  }
  .mr-kit__total {
    flex: 1 1 auto;
    font-size: 2rem;
  }
{% endstylesheet %}
