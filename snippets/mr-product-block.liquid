{% doc %}
  Renders the Makers Realm blocks of the product page (delivery line, key facts, safety callout, brand link, summary,
  assurance row, info popup and help box). Kept in one snippet so the main product section stays simple.

  @param {object} block - The block to render.
  @param {product} product - The product on the page.
{% enddoc %}

{%- case block.type -%}
  {%- when 'mr_delivery' -%}
    {%- render 'mr-delivery-line' -%}
  {%- when 'mr_key_facts' -%}
    {%- render 'mr-key-facts', product: product -%}
  {%- when 'mr_safety' -%}
    {%- render 'mr-safety-callout', product: product -%}
  {%- when 'mr_brand' -%}
    {%- render 'mr-brand-link', product: product, block: block -%}
  {%- when 'mr_summary' -%}
    {%- capture mr_summary -%}{%- render 'mr-product-summary', product: product -%}{%- endcapture -%}
    {%- if mr_summary != blank -%}
      <div class="product__description rte mr-summary" {{ block.shopify_attributes }}>
        {{ mr_summary | newline_to_br }}
      </div>
    {%- endif -%}
  {%- when 'mr_assurance' -%}
    {%- render 'mr-assurance', block: block -%}
  {%- when 'mr_info_popup' -%}
    {%- if block.settings.label != blank and block.settings.content != blank -%}
      <div class="mr-info-popup" {{ block.shopify_attributes }}>
        <button type="button" class="mr-info-popup__open link" data-mr-dialog="MrInfo-{{ block.id }}">
          {{- block.settings.label | escape -}}
        </button>
        <dialog id="MrInfo-{{ block.id }}" class="mr-dialog" aria-labelledby="MrInfo-{{ block.id }}-title">
          <div class="mr-dialog__panel">
            <button type="button" class="mr-dialog__close" aria-label="Close" data-mr-dialog-close>&times;</button>
            <h2 id="MrInfo-{{ block.id }}-title" class="mr-dialog__title h3">{{ block.settings.title | default: block.settings.label | escape }}</h2>
            <div class="rte">{{ block.settings.content }}</div>
          </div>
        </dialog>
      </div>
      <script src="{{ 'mr-dialog.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}
  {%- when 'mr_help_box' -%}
    {%- if block.settings.heading != blank and block.settings.link != blank -%}
      <div class="mr-help-box" {{ block.shopify_attributes }}>
        <strong>{{ block.settings.heading | escape }}</strong>
        {%- if block.settings.text != blank %} {{ block.settings.text | escape }}{% endif %}
        <a href="{{ block.settings.link }}">
          {{- block.settings.link_label | default: block.settings.heading | escape -}}
        </a>
      </div>
    {%- endif -%}
{%- endcase -%}
