{% doc %}
  Small outline icons for the trust strip and similar spots.

  @param {string} name - star, truck, heart, chat, shield, tag, clock or box.
{% enddoc %}

<svg class="mr-icon" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'star' -%}
      <path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.8-5.2 2.8 1-5.8L3.5 9.7l5.9-.9z" />
    {%- when 'truck' -%}
      <path d="M2.5 6.5h11v9h-11z" /><path d="M13.5 9.5h4l3 3v3h-7z" /><circle cx="7" cy="17.5" r="1.8" /><circle cx="17" cy="17.5" r="1.8" />
    {%- when 'heart' -%}
      <path d="M12 20s-7.5-4.6-7.5-10.2A4.3 4.3 0 0 1 12 7.4a4.3 4.3 0 0 1 7.5 2.4C19.5 15.4 12 20 12 20z" />
    {%- when 'chat' -%}
      <path d="M4 5.5h16v10H9.5L5.5 19v-3.5H4z" />
    {%- when 'shield' -%}
      <path d="M12 3.5l7 2.5v5.5c0 4.2-3 7.4-7 9-4-1.6-7-4.8-7-9V6z" /><path d="M9 12l2.2 2.2L15.2 10" />
    {%- when 'tag' -%}
      <path d="M3.5 12.2V4.5h7.7l9.3 9.3-7.7 7.7z" /><circle cx="8" cy="9" r="1.2" />
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="8.5" /><path d="M12 7.5V12l3 2" />
    {%- when 'box' -%}
      <path d="M3.5 7.5L12 3.5l8.5 4v9L12 20.5l-8.5-4z" /><path d="M3.5 7.5L12 11.5l8.5-4M12 11.5v9" />
  {%- endcase -%}
</svg>
