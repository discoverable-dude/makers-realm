{%- if section.blocks.size > 0 -%}
  <div class="mr-kits color-{{ section.settings.color_scheme }} gradient">
    <div class="mr-kits__inner page-width">
      {%- if section.settings.heading != blank -%}
        <h2 class="mr-kits__heading h2">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <p class="mr-kits__intro">{{ section.settings.intro | escape }}</p>
      {%- endif -%}
      <div class="mr-kits__grid">
        {%- for block in section.blocks -%}
          {%- if block.settings.products.size > 0 -%}
            {%- render 'mr-kit-card', uid: block.id, title: block.settings.title, text: block.settings.text, products: block.settings.products, button_label: block.settings.button_label, attributes: block.shopify_attributes -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .mr-kits {
    padding: 4rem 0;
  }

  .mr-kits__heading {
    margin: 0 0 0.8rem;
  }

  .mr-kits__intro {
    max-width: 60ch;
    margin: 0 0 2.4rem;
    color: var(--mr-muted);
  }

  .mr-kits__grid {
    display: grid;
    gap: 1.6rem;
  }













  @media screen and (min-width: 990px) {
    .mr-kits__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Starter kits",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Starter kits"
    },
    {
      "type": "text",
      "id": "intro",
      "label": "Intro line"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-mr-cream"
    }
  ],
  "blocks": [
    {
      "type": "kit",
      "name": "Kit",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Kit name"
        },
        {
          "type": "text",
          "id": "text",
          "label": "One line about the kit"
        },
        {
          "type": "product_list",
          "id": "products",
          "label": "Products",
          "limit": 6,
          "info": "Each shows its cheapest option that is in stock. Shoppers can change it before adding."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Add kit to basket"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Starter kits"
    }
  ]
}
{% endschema %}
