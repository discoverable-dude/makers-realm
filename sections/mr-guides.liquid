{%- if section.blocks.size > 0 -%}
  <div class="mr-guides color-{{ section.settings.color_scheme }} gradient">
    <div class="mr-guides__inner page-width">
      <div class="mr-guides__head">
        {%- if section.settings.heading != blank -%}
          <h2 class="mr-guides__heading h2">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.all_link != blank -%}
          <a class="mr-guides__all" href="{{ section.settings.all_link }}">{{ section.settings.all_label | default: 'All guides' | escape }}</a>
        {%- endif -%}
      </div>
      <ul class="mr-guides__list" role="list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <a class="mr-guide" {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %}>
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 800
                  | image_tag: widths: '400, 800', sizes: '(min-width: 990px) 33vw, 100vw', loading: 'lazy', class: 'mr-guide__image', alt: ''
                }}
              {%- elsif block.settings.art != 'none' -%}
                <img class="mr-guide__image" src="{{ 'mr-tile-' | append: block.settings.art | append: '.jpg' | asset_url }}" width="800" height="678" loading="lazy" alt="">
              {%- endif -%}
              <span class="mr-guide__kind">Guide</span>
              <span class="mr-guide__title">{{ block.settings.title | escape }}</span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .mr-guides {
    padding: 4rem 0;
  }

  .mr-guides__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.6rem;
    margin-bottom: 2.4rem;
  }

  .mr-guides__heading {
    margin: 0;
  }

  .mr-guides__all {
    color: var(--mr-navy);
  }

  .mr-guides__list {
    display: grid;
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mr-guide {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    color: var(--mr-navy);
    text-decoration: none;
  }

  .mr-guide__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 1px dashed var(--mr-sky);
    border-radius: 0.8rem;
  }

  .mr-guide__kind {
    margin-top: 0.8rem;
    color: var(--mr-muted);
    font-size: 1.3rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .mr-guide__title {
    font-size: 2rem;
    font-weight: 700;
  }

  .mr-guide:hover .mr-guide__title {
    text-decoration: underline;
  }

  @media screen and (min-width: 990px) {
    .mr-guides__list {
      grid-template-columns: repeat(3, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Guides",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Guides and tutorials"
    },
    {
      "type": "text",
      "id": "all_label",
      "label": "All guides link label",
      "default": "All guides"
    },
    {
      "type": "url",
      "id": "all_link",
      "label": "All guides link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-mr-cream-dark"
    }
  ],
  "blocks": [
    {
      "type": "guide",
      "name": "Guide",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "art",
          "label": "Built-in picture",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "cosplay", "label": "Helmet" },
            { "value": "model-making", "label": "Model cottage" },
            { "value": "millinery", "label": "Hat" },
            { "value": "home-crafting", "label": "Cast pots" },
            { "value": "all-materials", "label": "Silicone mould" }
          ],
          "default": "none"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Own picture"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Guides"
    }
  ]
}
{% endschema %}
