{%- if section.blocks.size > 0 -%}
  <div class="mr-trust color-{{ section.settings.color_scheme }} gradient">
    <ul class="mr-trust__list page-width" role="list">
      {%- for block in section.blocks -%}
        <li class="mr-trust__item" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != 'none' -%}
            <span class="mr-trust__icon">{% render 'mr-icon', name: block.settings.icon %}</span>
          {%- endif -%}
          <strong class="mr-trust__title">{{ block.settings.title | escape }}</strong>
          {%- if block.settings.text != blank -%}
            <span class="mr-trust__text">{{ block.settings.text | escape }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}

{% stylesheet %}
  .mr-trust {
    border-top: 1px solid var(--mr-tan);
    border-bottom: 1px solid var(--mr-tan);
  }

  .mr-trust__list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.4rem 1.6rem;
    margin: 0 auto;
    padding-top: 5.6rem;
    padding-bottom: 5.6rem;
    list-style: none;
  }

  .mr-trust__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    text-align: center;
  }

  .mr-trust__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 5.2rem;
    height: 5.2rem;
    margin-bottom: 0.6rem;
    border: 1px dashed var(--mr-sky);
    border-radius: 50%;
    background: #fff;
    color: var(--mr-red);
  }

  .mr-trust__title {
    color: var(--mr-navy);
    font-size: 1.8rem;
  }

  .mr-trust__text {
    color: var(--mr-muted);
  }

  @media screen and (min-width: 990px) {
    .mr-trust__list {
      grid-template-columns: repeat(4, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Trust strip",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Short facts about the shop, text only. Add only facts that are true and can be backed up. Nothing shows until an item is added."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-mr-cream-dark"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "star", "label": "Star" },
            { "value": "truck", "label": "Delivery van" },
            { "value": "heart", "label": "Heart" },
            { "value": "chat", "label": "Speech bubble" },
            { "value": "shield", "label": "Shield with tick" },
            { "value": "tag", "label": "Price tag" },
            { "value": "clock", "label": "Clock" },
            { "value": "box", "label": "Parcel" }
          ],
          "default": "star"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Supporting line"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Trust strip"
    }
  ]
}
{% endschema %}
