<div class="mr-cta color-{{ section.settings.color_scheme }} gradient">
  <div class="mr-cta__inner page-width">
    <div class="mr-cta__copy">
      <h2 class="mr-cta__heading h3">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="mr-cta__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>
    {%- if section.settings.button_link != blank and section.settings.button_label != blank -%}
      <a class="button" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .mr-cta {
    padding: 3rem 0;
  }
  .mr-cta__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.6rem 3rem;
  }
  .mr-cta__heading {
    margin: 0 0 0.4rem;
  }
  .mr-cta__text {
    max-width: 56ch;
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Call to action band",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Not sure what to buy?" },
    { "type": "text", "id": "text", "label": "Text", "default": "Tell us what you are making and we will build you a shopping list." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Find your kit" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-mr-cream-dark" }
  ],
  "presets": [{ "name": "Call to action band" }]
}
{% endschema %}
