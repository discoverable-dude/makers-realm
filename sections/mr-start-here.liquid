{%- if section.settings.heading != blank and section.settings.button_link != blank -%}
  <div class="mr-start-here color-{{ section.settings.color_scheme }} gradient">
    <div class="mr-start-here__inner page-width">
      <div class="mr-start-here__text">
        <h2 class="mr-start-here__heading h3">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}
          <div class="rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
      <a class="button button--secondary" href="{{ section.settings.button_link }}">
        {{- section.settings.button_label | default: section.settings.heading | escape -}}
      </a>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .mr-start-here {
    padding: 3.2rem 0;
  }

  .mr-start-here__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.6rem 3.2rem;
  }

  .mr-start-here__heading {
    margin: 0 0 0.8rem;
  }

  .mr-start-here__text {
    flex: 1 1 32rem;
  }

  .mr-start-here__text .rte > :last-child {
    margin-bottom: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Start here strip",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "A short beginner prompt with one button. Hidden until a heading and a link are filled in."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-mr-cream-dark"
    }
  ],
  "presets": [
    {
      "name": "Start here strip"
    }
  ]
}
{% endschema %}
