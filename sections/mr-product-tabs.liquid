{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'quick-add.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign tab_count = 0
  for block in section.blocks
    if block.settings.collection != blank and block.settings.collection.products_count > 0
      assign tab_count = tab_count | plus: 1
    endif
  endfor
-%}

{%- if tab_count > 0 -%}
  <mr-product-tabs class="mr-tabs color-{{ section.settings.color_scheme }} gradient">
    <div class="mr-tabs__inner page-width">
      <div class="mr-tabs__head">
        {%- if section.settings.heading != blank -%}
          <h2 class="mr-tabs__heading h2">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        <div class="mr-tabs__list" role="tablist" aria-label="{{ section.settings.heading | escape }}">
          {%- assign tab_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.collection != blank and block.settings.collection.products_count > 0 -%}
              {%- assign tab_index = tab_index | plus: 1 -%}
              <button
                type="button"
                role="tab"
                class="mr-tabs__tab"
                id="MrTab-{{ block.id }}"
                aria-controls="MrPanel-{{ block.id }}"
                aria-selected="{% if tab_index == 1 %}true{% else %}false{% endif %}"
                tabindex="{% if tab_index == 1 %}0{% else %}-1{% endif %}"
                {{ block.shopify_attributes }}
              >
                {{- block.settings.label | escape -}}
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      {%- assign panel_index = 0 -%}
      {%- assign skip_styles = false -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.collection != blank and block.settings.collection.products_count > 0 -%}
          {%- assign panel_index = panel_index | plus: 1 -%}
          <div
            class="mr-tabs__panel"
            role="tabpanel"
            id="MrPanel-{{ block.id }}"
            aria-labelledby="MrTab-{{ block.id }}"
            {% unless panel_index == 1 %}
              hidden
            {% endunless %}
          >
            <ul class="mr-tabs__grid" role="list">
              {%- for product in block.settings.collection.products limit: 5 -%}
                <li>
                  {% render 'card-product',
                    card_product: product,
                    media_aspect_ratio: 'square',
                    lazy_load: true,
                    skip_styles: skip_styles,
                    section_id: section.id,
                    quick_add: 'standard',
                    product_view_context: 'collection'
                  %}
                </li>
                {%- assign skip_styles = true -%}
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </mr-product-tabs>
  <script src="{{ 'mr-product-tabs.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% stylesheet %}
  .mr-tabs {
    padding: 4rem 0;
  }

  .mr-tabs__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem 2.4rem;
    margin-bottom: 2.4rem;
  }

  .mr-tabs__heading {
    margin: 0;
  }

  .mr-tabs__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .mr-tabs__tab {
    min-height: 4.4rem;
    padding: 0 1.8rem;
    border: 1px solid var(--mr-navy);
    background: transparent;
    color: var(--mr-navy);
    font: inherit;
    cursor: pointer;
  }

  .mr-tabs__tab[aria-selected='true'] {
    background: var(--mr-navy);
    color: #fff;
  }

  .mr-tabs__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media screen and (min-width: 990px) {
    .mr-tabs__grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product tabs",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Right now at Makers Realm"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-mr-cream"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Tab label"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Product tabs"
    }
  ]
}
{% endschema %}
