{%- liquid
  assign shown = 0
  assign tile_index = 0
  for block in section.blocks
    if block.settings.collection != blank
      assign shown = shown | plus: 1
    endif
  endfor
-%}

{%- if shown > 0 -%}
  <div class="mr-cgrid color-{{ section.settings.color_scheme }} gradient">
    <div class="mr-cgrid__inner page-width">
      <div class="mr-cgrid__head">
        {%- if section.settings.heading != blank -%}
          <h2 class="mr-cgrid__heading h2">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        <a class="mr-cgrid__all" href="{{ routes.all_products_collection_url }}">View all products</a>
      </div>
      <ul class="mr-cgrid__list" role="list">
        {%- for block in section.blocks -%}
          {%- assign c = block.settings.collection -%}
          {%- if c != blank -%}
            {%- assign tile_index = tile_index | plus: 1 -%}
            <li class="mr-cgrid__cell{% if tile_index == 1 %} mr-cgrid__cell--large{% endif %}" {{ block.shopify_attributes }}>
              <a class="mr-cgrid__tile" href="{{ c.url }}">
                {%- if c.featured_image -%}
                  {{
                    c.featured_image
                    | image_url: width: 900
                    | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 990px) 25vw, 50vw', class: 'mr-cgrid__image', alt: c.title
                  }}
                {%- endif -%}
                <span class="mr-cgrid__label">
                  <strong>{{ c.title | escape }}</strong>
                  <span>{{ c.products_count }} {{ c.products_count | pluralize: 'product', 'products' }}</span>
                </span>
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .mr-cgrid {
    padding: 4rem 0;
  }

  .mr-cgrid__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.6rem;
    margin-bottom: 2.4rem;
  }

  .mr-cgrid__heading {
    margin: 0;
  }

  .mr-cgrid__list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mr-cgrid__cell--large {
    grid-column: span 2;
  }

  .mr-cgrid__tile {
    position: relative;
    display: block;
    height: 100%;
    min-height: 20rem;
    overflow: hidden;
    border: 1px dashed var(--mr-sky);
    border-radius: 0.8rem;
    background: var(--mr-cream-dark);
    color: var(--mr-navy);
    text-decoration: none;
  }

  .mr-cgrid__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mr-cgrid__label {
    position: absolute;
    left: 1.2rem;
    bottom: 1.2rem;
    display: flex;
    flex-direction: column;
    padding: 0.8rem 1.2rem;
    border-radius: 0.4rem;
    background: #fff;
  }

  @media screen and (min-width: 990px) {
    .mr-cgrid__list {
      grid-template-columns: repeat(4, 1fr);
      grid-template-rows: repeat(2, 22rem);
    }

    .mr-cgrid__cell--large {
      grid-column: span 2;
      grid-row: span 2;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "One large collection tile followed by smaller ones. Uses each collection's own image. Nothing shows until collections are chosen. Five collections fill the layout."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by collection"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-mr-cream"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Collection grid"
    }
  ]
}
{% endschema %}
