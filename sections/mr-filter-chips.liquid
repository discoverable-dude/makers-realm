{%- liquid
  assign filter_param = section.settings.filter_param | strip
  assign any_active = false
  for filter in collection.filters
    if filter.param_name == filter_param and filter.active_values.size > 0
      assign any_active = true
    endif
  endfor
-%}

{%- if section.blocks.size > 0 and filter_param != blank -%}
  <div class="mr-chips color-{{ section.settings.color_scheme }} gradient">
    <div class="mr-chips__inner page-width">
      {%- if section.settings.heading != blank -%}
        <h2 class="mr-chips__heading h3">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <p class="mr-chips__intro">{{ section.settings.intro | escape }}</p>
      {%- endif -%}
      <ul class="mr-chips__list" role="list">
        {%- if section.settings.all_label != blank -%}
          <li>
            <a
              class="mr-chip{% unless any_active %} mr-chip--active{% endunless %}"
              href="{{ collection.url }}"
              {% unless any_active %}
                aria-current="true"
              {% endunless %}
            >
              <span class="mr-chip__title">{{ section.settings.all_label | escape }}</span>
              {%- if section.settings.all_text != blank -%}
                <span class="mr-chip__text">{{ section.settings.all_text | escape }}</span>
              {%- endif -%}
            </a>
          </li>
        {%- endif -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign is_active = false
            for filter in collection.filters
              if filter.param_name == filter_param
                for active_value in filter.active_values
                  if active_value.value == block.settings.value
                    assign is_active = true
                  endif
                endfor
              endif
            endfor
          -%}
          <li {{ block.shopify_attributes }}>
            <a
              class="mr-chip{% if is_active %} mr-chip--active{% endif %}"
              href="{{ collection.url }}?{{ filter_param }}={{ block.settings.value | url_encode }}"
              {% if is_active %}
                aria-current="true"
              {% endif %}
            >
              <span class="mr-chip__title">{{ block.settings.label | escape }}</span>
              {%- if block.settings.text != blank -%}
                <span class="mr-chip__text">{{ block.settings.text | escape }}</span>
              {%- endif -%}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .mr-chips {
    padding: 2rem 0 0.4rem;
  }

  .mr-chips__heading {
    margin: 0 0 1.2rem;
    color: var(--mr-muted);
    font-family: var(--mr-font-body);
    font-size: 1.3rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .mr-chip {
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 0.2rem;
    border-radius: 0;
    background: #fff;
  }

  .mr-chip__title {
    font-family: var(--mr-font-hand);
    font-size: 2.2rem;
    line-height: 1.1;
  }

  .mr-chip__text {
    color: var(--mr-muted);
    font-size: 1.4rem;
  }

  .mr-chip--active .mr-chip__text {
    color: inherit;
  }

  .mr-chips__intro {
    margin: 0 0 1.2rem;
  }

  .mr-chips__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mr-chip {
    display: inline-flex;
    min-height: 4.4rem;
    padding: 1rem 1.8rem;
    border: 1px solid var(--mr-navy);
    color: var(--mr-navy);
    text-decoration: none;
    white-space: nowrap;
  }

  .mr-chip:hover {
    background: rgba(var(--color-foreground), 0.08);
  }

  .mr-chip--active {
    background: var(--mr-navy);
    color: #fff;
  }

  @media screen and (max-width: 749px) {
    .mr-chips__list {
      flex-wrap: nowrap;
      overflow-x: auto;
      padding-bottom: 0.8rem;
      -webkit-overflow-scrolling: touch;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Filter chips",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "A row of links that apply a collection filter. Nothing shows until at least one chip is added. The filter must be switched on in the Shopify Search & Discovery app first."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "intro",
      "label": "Intro line"
    },
    {
      "type": "text",
      "id": "filter_param",
      "label": "Filter parameter",
      "default": "filter.p.m.custom.project_type",
      "info": "For a product metafield filter use filter.p.m.<namespace>.<key>. For product tags use filter.p.tag."
    },
    {
      "type": "text",
      "id": "all_label",
      "label": "Label for the clear chip",
      "default": "All"
    },
    {
      "type": "text",
      "id": "all_text",
      "label": "Small line under the clear chip"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-mr-cream"
    }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Chip",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Small line under the label"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Filter value",
          "info": "Must match the metafield value or tag exactly."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Filter chips"
    }
  ]
}
{% endschema %}
