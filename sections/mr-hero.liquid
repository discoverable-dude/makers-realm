{%- liquid
  assign art = section.settings.art
  assign has_art = false
  if section.settings.background != blank or art != 'none'
    assign has_art = true
  endif
  assign is_photo = false
  if section.settings.background != blank or art contains 'photo'
    assign is_photo = true
  endif
-%}

<div class="mr-hero color-{{ section.settings.color_scheme }} gradient{% if has_art %} mr-hero--art{% endif %}{% if is_photo %} mr-hero--photo{% endif %}">
  {%- if has_art -%}
    <div class="mr-hero__stage">
      {%- if section.settings.background != blank -%}
        {{
          section.settings.background
          | image_url: width: 2000
          | image_tag: widths: '900, 1400, 2000', sizes: '100vw', loading: 'eager', fetchpriority: 'high', class: 'mr-hero__art', alt: ''
        }}
      {%- else -%}
        {%- assign art_base = 'mr-hero-' | append: art -%}
        <img
          class="mr-hero__art"
          src="{{ art_base | append: '-2000.jpg' | asset_url }}"
          srcset="{{ art_base | append: '-900.jpg' | asset_url }} 900w, {{ art_base | append: '-2000.jpg' | asset_url }} 2000w"
          sizes="100vw"
          width="2000"
          height="848"
          alt=""
          fetchpriority="high"
        >
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="mr-hero__inner page-width">
    {%- if section.settings.banner != blank -%}
      <div class="mr-hero__banner">
        {{
          section.settings.banner
          | image_url: width: 1600
          | image_tag: widths: '600, 900, 1200, 1600', sizes: '(min-width: 1200px) 1100px, 100vw', loading: 'eager', fetchpriority: 'high', class: 'mr-hero__banner-image'
        }}
      </div>
    {%- endif -%}

    <div class="mr-hero__row{% if section.settings.image != blank %} mr-hero__row--with-image{% endif %}">
      <div class="mr-hero__text">
        {%- if section.settings.heading != blank -%}
          <h2 class="mr-hero__heading h0">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="mr-hero__sub">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
        <div class="mr-hero__buttons">
          {%- if section.settings.button_label_1 != blank and section.settings.button_link_1 != blank -%}
            <a class="button" href="{{ section.settings.button_link_1 }}">{{ section.settings.button_label_1 | escape }}</a>
          {%- endif -%}
          {%- if section.settings.button_label_2 != blank and section.settings.button_link_2 != blank -%}
            <a class="button button--secondary" href="{{ section.settings.button_link_2 }}">{{ section.settings.button_label_2 | escape }}</a>
          {%- endif -%}
        </div>
      </div>

      {%- if section.settings.image != blank -%}
        <div class="mr-hero__image">
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag: widths: '500, 800, 1200', sizes: '(min-width: 990px) 540px, 100vw', loading: 'lazy', class: 'mr-hero__photo'
          }}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .mr-hero {
    padding: 2.4rem 0 4rem;
  }

  .mr-hero__banner {
    margin: 0 auto 3.2rem;
    max-width: 90rem;
  }

  .mr-hero__banner-image {
    display: block;
    width: 100%;
    height: auto;
  }

  .mr-hero__row {
    display: grid;
    gap: 2.4rem;
    align-items: center;
  }

  .mr-hero__heading {
    margin: 0 0 1.2rem;
  }

  .mr-hero__sub {
    max-width: 52rem;
    margin: 0 0 2.4rem;
    color: var(--mr-muted);
  }

  .mr-hero__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
  }

  .mr-hero__photo {
    display: block;
    width: 100%;
    height: auto;
    border: 1px dashed var(--mr-sky);
    border-radius: 0.8rem;
  }

  .mr-hero--art {
    position: relative;
    padding: 0 0 3.2rem;
  }

  .mr-hero__stage {
    margin-bottom: 2.4rem;
  }

  .mr-hero__art {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2000 / 848;
    object-fit: cover;
    object-position: right center;
  }

  @media screen and (min-width: 990px) {
    .mr-hero--art {
      padding: 0;
    }

    .mr-hero--art .mr-hero__stage {
      margin: 0;
    }

    .mr-hero--art .mr-hero__inner {
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      left: 0;
      display: flex;
      align-items: center;
    }

    .mr-hero--art .mr-hero__row {
      width: 46%;
    }

    .mr-hero--photo .mr-hero__stage::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, rgba(246, 240, 226, 0.94) 0, rgba(246, 240, 226, 0.86) 34%, rgba(246, 240, 226, 0) 62%);
    }

    .mr-hero--art {
      overflow: hidden;
    }
  }

  @media screen and (min-width: 990px) {
    .mr-hero__row--with-image {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Makers Realm hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "art",
      "label": "Hero artwork",
      "info": "Built-in artwork. Pick an image below to use your own instead.",
      "options": [
        { "value": "watercolour-shelf", "label": "Watercolour, shelves and helmet" },
        { "value": "watercolour-bunting", "label": "Watercolour, bunting and shelves" },
        { "value": "photo-window", "label": "Photo, helmet by the window" },
        { "value": "photo-shelves", "label": "Photo, helmet and paint shelves" },
        { "value": "none", "label": "None" }
      ],
      "default": "watercolour-shelf"
    },
    {
      "type": "image_picker",
      "id": "background",
      "label": "Own hero image",
      "info": "Wide image, about 2000 by 850, with empty space on the left for the text."
    },
    {
      "type": "image_picker",
      "id": "banner",
      "label": "Banner artwork (above the text, no hero image)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "Step inside the Makers Realm"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Supporting line"
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "Main button label",
      "default": "Shop all materials"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Main button link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Second button label"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Second button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo (optional)",
      "info": "A finished build. Leave empty to centre the text."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-mr-cream"
    }
  ],
  "presets": [
    {
      "name": "Makers Realm hero"
    }
  ]
}
{% endschema %}
