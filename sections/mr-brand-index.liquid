{%- liquid
  assign brand_names = shop.vendors | sort_natural
-%}

<div class="mr-bi color-{{ section.settings.color_scheme }} gradient">
  <div class="mr-bi__inner page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="mr-bi__heading h2">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <ul class="mr-bi__list" role="list">
      {%- for brand in brand_names -%}
        {%- if brand != shop.name -%}
          <li><a class="mr-bi__link" href="{{ brand | url_for_vendor }}">{{ brand | escape }}</a></li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</div>

{% stylesheet %}
  .mr-bi {
    padding: 2.4rem 0 4rem;
  }

  .mr-bi__heading {
    margin: 0 0 2rem;
  }

  .mr-bi__list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.4rem 2.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mr-bi__link {
    display: block;
    padding: 1rem 0;
    border-bottom: 1px solid var(--mr-tan);
    color: var(--mr-navy);
    font-size: 1.8rem;
    text-decoration: none;
  }

  .mr-bi__link:hover {
    text-decoration: underline;
  }

  @media screen and (min-width: 750px) {
    .mr-bi__list {
      grid-template-columns: repeat(4, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Brand index",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Lists every brand in the shop automatically from the Vendor field, A to Z. Use on a page with the Brands template."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "All brands"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-mr-cream"
    }
  ],
  "presets": [
    {
      "name": "Brand index"
    }
  ]
}
{% endschema %}
