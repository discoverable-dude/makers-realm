{%- if section.blocks.size > 0 -%}
  {{ 'component-card.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>

  <div class="mr-stages color-{{ section.settings.color_scheme }} gradient" id="stages">
    <div class="mr-stages__inner page-width">
      {%- if section.settings.heading != blank -%}
        <h2 class="mr-stages__heading h2">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- assign skip_styles = false -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.products.size > 0 -%}
          <section class="mr-stage" aria-labelledby="Stage-{{ block.id }}" {{ block.shopify_attributes }}>
            <div class="mr-stage__head">
              <h3 class="mr-stage__title h3" id="Stage-{{ block.id }}">{{ block.settings.heading | escape }}</h3>
              {%- if block.settings.text != blank -%}
                <p class="mr-stage__text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </div>
            <ul class="mr-stage__grid" role="list">
              {%- for product in block.settings.products limit: 6 -%}
                <li>
                  {% render 'card-product',
                    card_product: product,
                    media_aspect_ratio: 'square',
                    lazy_load: true,
                    skip_styles: skip_styles,
                    show_vendor: true,
                    section_id: section.id,
                    quick_add: 'standard',
                    product_view_context: 'collection'
                  %}
                </li>
                {%- assign skip_styles = true -%}
              {%- endfor -%}
            </ul>
          </section>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .mr-stages {
    padding: 4rem 0;
  }

  .mr-stages__heading {
    margin: 0 0 3.2rem;
  }

  .mr-stage {
    padding: 2.4rem 0 3.2rem;
    border-top: 1px solid var(--mr-tan);
  }

  .mr-stage__head {
    margin-bottom: 1.6rem;
  }

  .mr-stage__title {
    margin: 0 0 0.4rem;
  }

  .mr-stage__text {
    max-width: 60ch;
    margin: 0;
    color: var(--mr-muted);
  }

  .mr-stage__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media screen and (min-width: 990px) {
    .mr-stage__grid {
      grid-template-columns: repeat(6, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Project stages",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What you will need"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-mr-cream"
    }
  ],
  "blocks": [
    {
      "type": "stage",
      "name": "Stage",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Stage name"
        },
        {
          "type": "text",
          "id": "text",
          "label": "One line about this stage"
        },
        {
          "type": "product_list",
          "id": "products",
          "label": "Products",
          "limit": 6
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Project stages"
    }
  ]
}
{% endschema %}
