<div class="mr-info color-{{ section.settings.color_scheme }} gradient">
  <div class="mr-info__inner page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="mr-info__heading h2">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.show_page_content and page.content != blank -%}
      <div class="mr-info__story rte">{{ page.content }}</div>
    {%- endif -%}
    {%- if section.settings.intro != blank -%}
      <p class="mr-info__intro">{{ section.settings.intro | escape }}</p>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <ul class="mr-info__list" role="list">
        {%- for block in section.blocks -%}
          <li class="mr-info__item" {{ block.shopify_attributes }}>
            <h3 class="mr-info__title h4">{{ block.settings.title | escape }}</h3>
            <p class="mr-info__body">{{ block.settings.text | escape }}</p>
            {%- if block.settings.link != blank and block.settings.link_label != blank -%}
              <a class="link" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .mr-info {
    padding: 4rem 0;
  }
  .mr-info__heading {
    margin: 0 0 1.2rem;
  }
  .mr-info__story,
  .mr-info__intro {
    max-width: 68ch;
    margin: 0 0 2.4rem;
  }
  .mr-info__list {
    display: grid;
    gap: 1.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .mr-info__item {
    padding: 2rem;
    border: 1px dashed var(--mr-sky);
    border-radius: 0.8rem;
    background: #fff;
    color: var(--mr-navy);
  }
  .mr-info__title {
    margin: 0 0 0.6rem;
  }
  .mr-info__body {
    margin: 0 0 1rem;
  }
  @media screen and (min-width: 750px) {
    .mr-info__list {
      grid-template-columns: repeat(auto-fit, minmax(24rem, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Info columns",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "checkbox", "id": "show_page_content", "label": "Show the page's own text above the columns", "default": false },
    { "type": "textarea", "id": "intro", "label": "Intro" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-mr-cream" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Column",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Info columns" }]
}
{% endschema %}
