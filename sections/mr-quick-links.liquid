{%- if section.blocks.size > 0 -%}
  <div class="mr-ql color-{{ section.settings.color_scheme }} gradient">
    <div class="mr-ql__inner page-width">
      {%- if section.settings.heading != blank -%}
        <h2 class="mr-ql__heading h3">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      <ul class="mr-ql__list" role="list">
        {%- for block in section.blocks -%}
          {%- if block.settings.label != blank -%}
            <li {{ block.shopify_attributes }}>
              <a class="mr-ql__link" href="{{ block.settings.link | default: routes.search_url }}{% if block.settings.link == blank %}?q={{ block.settings.label | url_encode }}&type=product{% endif %}">
                {{- block.settings.label | escape -}}
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .mr-ql {
    padding: 3.2rem 0;
    text-align: center;
  }

  .mr-ql__heading {
    margin: 0 0 1.6rem;
  }

  .mr-ql__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mr-ql__link {
    display: inline-flex;
    align-items: center;
    min-height: 4.4rem;
    padding: 0 1.8rem;
    border: 1px solid var(--mr-navy);
    border-radius: 4rem;
    color: var(--mr-navy);
    text-decoration: none;
  }

  .mr-ql__link:hover {
    background: var(--mr-navy);
    color: #fff;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Quick links",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Round buttons that link to a page, or to a search for the label if no link is set. Good for the page-not-found and empty search screens."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Popular searches"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-mr-cream"
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Quick links"
    }
  ]
}
{% endschema %}
