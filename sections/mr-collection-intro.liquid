{%- assign how_to_choose = collection.metafields.custom.how_to_choose.value -%}
<div class="mr-intro color-{{ section.settings.color_scheme }} gradient">
  <div class="mr-intro__inner page-width">
    <div class="mr-intro__copy">
      <h2 class="mr-intro__heading h4">{{ section.settings.heading | escape }}</h2>
      <p class="mr-intro__text">
        {%- if how_to_choose != blank -%}
          {{- how_to_choose | escape -}}
        {%- else -%}
          {{- section.settings.fallback_text | escape -}}
        {%- endif -%}
      </p>
    </div>
    <div class="mr-intro__links">
      {%- if section.settings.finder_link != blank -%}
        <a class="button button--secondary" href="{{ section.settings.finder_link }}">{{ section.settings.finder_label | escape }}</a>
      {%- endif -%}
      {%- if section.settings.help_link != blank -%}
        <a class="link" href="{{ section.settings.help_link }}">{{ section.settings.help_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .mr-intro {
    padding: 2rem 0;
  }
  .mr-intro__inner {
    display: grid;
    gap: 1.2rem 3rem;
    align-items: center;
  }
  .mr-intro__heading {
    margin: 0 0 0.4rem;
  }
  .mr-intro__text {
    max-width: 70ch;
    margin: 0;
  }
  .mr-intro__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
  }
  @media screen and (min-width: 990px) {
    .mr-intro__inner {
      grid-template-columns: 1fr auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection how to choose",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "How to choose" },
    { "type": "textarea", "id": "fallback_text", "label": "Text when the collection has none", "default": "Not sure which to pick? Tell us what you are making and we will build you a shopping list." },
    { "type": "text", "id": "finder_label", "label": "Finder button label", "default": "Find your kit" },
    { "type": "url", "id": "finder_link", "label": "Finder button link" },
    { "type": "text", "id": "help_label", "label": "Help link label", "default": "Ask us before you order" },
    { "type": "url", "id": "help_link", "label": "Help link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-mr-white" }
  ],
  "presets": [{ "name": "Collection how to choose" }]
}
{% endschema %}
